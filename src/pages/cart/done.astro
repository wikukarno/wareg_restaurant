---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Container from "~/components/ui/Container.astro";
import Button from "~/components/ui/Button.astro";
import Icon from "~/components/icons/Icon.astro";
---
<BaseLayout title="Order received">
  <section class="pt-16 pb-24">
    <Container class="max-w-2xl">
      <div id="confirmation" class="rounded-3xl border border-[var(--color-line)] bg-[var(--color-surface)] p-8 md:p-12">
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-[var(--color-success)]/15 text-[var(--color-success)]">
          <Icon name="check" />
        </div>
        <h1 class="mt-5 font-display text-3xl md:text-4xl">Order received.</h1>
        <p class="mt-2 text-[var(--color-ink-soft)]">Thanks — the kitchen is on it.</p>

        <dl class="mt-8 grid grid-cols-2 gap-4 text-sm">
          <div>
            <dt class="text-[var(--color-ink-soft)]">Order ID</dt>
            <dd id="conf-id" class="font-mono mt-1">—</dd>
          </div>
          <div>
            <dt class="text-[var(--color-ink-soft)]">ETA</dt>
            <dd id="conf-eta" class="font-mono mt-1">—</dd>
          </div>
        </dl>

        <div class="mt-8">
          <p class="font-display text-lg">Summary</p>
          <div id="conf-lines" class="mt-3 divide-y divide-[var(--color-line)]"></div>
          <div class="mt-5 space-y-1 text-sm">
            <div class="flex justify-between"><span class="text-[var(--color-ink-soft)]">Subtotal</span><span id="conf-sub" class="font-mono"></span></div>
            <div class="flex justify-between"><span class="text-[var(--color-ink-soft)]">Delivery</span><span id="conf-del" class="font-mono"></span></div>
            <div class="flex justify-between pt-2 border-t border-[var(--color-line)]"><span>Total</span><span id="conf-tot" class="font-mono text-base"></span></div>
          </div>
        </div>

        <div class="mt-10 flex flex-wrap gap-3">
          <Button href="/menu" size="lg">Back to menu</Button>
          <Button href="/" variant="secondary" size="lg">Home</Button>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>

<script>
  import { formatIDR } from "~/lib/format";

  const raw = localStorage.getItem("wareg:lastOrder");
  if (!raw) {
    window.location.href = "/";
  } else {
    const order = JSON.parse(raw);
    document.getElementById("conf-id").textContent = order.orderId;
    document.getElementById("conf-eta").textContent = `${order.etaMinutes} min`;
    document.getElementById("conf-sub").textContent = formatIDR(order.subtotal);
    document.getElementById("conf-del").textContent = formatIDR(order.delivery);
    document.getElementById("conf-tot").textContent = formatIDR(order.total);
    document.getElementById("conf-lines").innerHTML = order.items.map((l) => `
      <div class="flex items-center gap-3 py-3">
        <img src="${l.image}" alt="" class="w-12 h-12 rounded-lg object-cover" />
        <div class="flex-1">
          <p class="text-sm font-medium">${l.name}</p>
          <p class="text-xs font-mono text-[var(--color-ink-soft)]">${l.qty} × ${formatIDR(l.price)}</p>
        </div>
        <p class="font-mono text-sm">${formatIDR(l.price * l.qty)}</p>
      </div>`).join("");
  }
</script>
