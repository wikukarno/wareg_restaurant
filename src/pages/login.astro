---
import AuthLayout from "~/layouts/AuthLayout.astro";
import Input from "~/components/ui/Input.astro";
import Button from "~/components/ui/Button.astro";
import Icon from "~/components/icons/Icon.astro";
---
<AuthLayout title="Log in">
  <h1 class="font-display text-3xl md:text-4xl">Welcome back.</h1>
  <p class="mt-2 text-[var(--color-ink-soft)]">Log in to track your orders.</p>

  <form id="login-form" class="mt-8 space-y-4" novalidate>
    <Input id="email" name="email" label="Email" type="email" required autocomplete="email" placeholder="you@example.com" />
    <Input id="password" name="password" label="Password" type="password" required autocomplete="current-password" placeholder="••••••••" />
    <p id="form-error" class="hidden text-sm text-[var(--color-accent)]" role="alert"></p>
    <Button type="submit" class="w-full" size="lg">Sign in <Icon name="arrow-right" size={18} /></Button>
  </form>

  <div class="mt-6 flex items-center gap-3 text-xs text-[var(--color-ink-soft)]">
    <span class="flex-1 h-px bg-[var(--color-line)]"></span>
    <span class="uppercase tracking-wider">or</span>
    <span class="flex-1 h-px bg-[var(--color-line)]"></span>
  </div>
  <button type="button" class="mt-4 w-full inline-flex items-center justify-center gap-2 rounded-full border border-[var(--color-line)] bg-[var(--color-surface)] px-5 py-3 text-sm hover:bg-[var(--color-amber-50)]">
    <img src="/images/ic_google.svg" alt="" class="w-4 h-4" /> Continue with Google
  </button>
  <p class="mt-8 text-sm text-[var(--color-ink-soft)]">
    New here? <a href="/register" class="text-[var(--color-ink)] underline underline-offset-4 hover:text-[var(--color-amber-600)]">Create an account</a>
  </p>
  <p class="mt-2 text-xs text-[var(--color-ink-soft)]">Demo login: <span class="font-mono">demo@wareg.id</span> / <span class="font-mono">demo1234</span></p>
</AuthLayout>

<script>
  import { login } from "~/lib/auth";

  const form = document.getElementById("login-form");
  const errEl = document.getElementById("form-error");
  form.addEventListener("submit", (e) => {
    e.preventDefault();
    errEl.classList.add("hidden");
    errEl.textContent = "";
    const fd = new FormData(form);
    const email = String(fd.get("email") ?? "");
    const password = String(fd.get("password") ?? "");
    const res = login(email, password);
    if (!res.ok) {
      errEl.textContent = res.error;
      errEl.classList.remove("hidden");
      return;
    }
    window.location.href = "/";
  });
</script>
