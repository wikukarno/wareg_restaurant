---
import Container from "~/components/ui/Container.astro";
import Button from "~/components/ui/Button.astro";
import Icon from "~/components/icons/Icon.astro";
---
<section class="py-16 md:py-24">
  <Container>
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-[var(--color-amber-50)] via-[#FFE8C2] to-[#FFD58A] px-8 py-14 md:p-16">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
        <div>
          <h3 class="font-display text-3xl md:text-4xl leading-tight">
            Stay warm. <span class="italic">Get weekly menu drops.</span>
          </h3>
          <p class="mt-3 text-[var(--color-ink-soft)] max-w-md">
            New dishes, chef's picks, and quiet promos. One email a week, no spam.
          </p>
        </div>
        <form id="newsletter-form" class="flex flex-col sm:flex-row gap-3">
          <label for="newsletter-email" class="sr-only">Email</label>
          <input
            id="newsletter-email"
            name="email"
            type="email"
            required
            placeholder="you@example.com"
            class="flex-1 rounded-full border border-[var(--color-line)] bg-[var(--color-surface)] px-5 py-3 text-sm focus:border-[var(--color-amber-500)] focus:ring-4 focus:ring-[var(--color-amber-500)]/15 outline-none"
          />
          <Button type="submit" size="lg">Subscribe <Icon name="arrow-right" size={18} /></Button>
        </form>
      </div>
    </div>
  </Container>
</section>

<script>
  const form = document.getElementById("newsletter-form") as HTMLFormElement | null;
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    form.reset();
    window.dispatchEvent(new CustomEvent("toast", { detail: { message: "You're on the list. See you next week." } }));
  });
</script>
