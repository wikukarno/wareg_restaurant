---
interface Props {
  id: string;
  name: string;
  label: string;
  type?: string;
  placeholder?: string;
  required?: boolean;
  autocomplete?: string;
  value?: string;
}
const {
  id, name, label,
  type = "text",
  placeholder,
  required = false,
  autocomplete,
  value = "",
} = Astro.props;
---
<div class="flex flex-col gap-1.5">
  <label for={id} class="text-sm font-medium text-[var(--color-ink)]">
    {label}{required && <span class="text-[var(--color-accent)]" aria-hidden="true"> *</span>}
  </label>
  <input
    id={id}
    name={name}
    type={type}
    placeholder={placeholder}
    required={required}
    autocomplete={autocomplete}
    value={value}
    aria-describedby={`${id}-error`}
    class="rounded-lg border border-[var(--color-line)] bg-[var(--color-surface)] px-4 py-2.5 text-[var(--color-ink)] placeholder:text-[var(--color-ink-soft)]/60 focus:border-[var(--color-amber-500)] focus:ring-4 focus:ring-[var(--color-amber-500)]/15 outline-none transition-all"
  />
  <p id={`${id}-error`} class="hidden text-xs text-[var(--color-accent)]" role="alert"></p>
</div>
