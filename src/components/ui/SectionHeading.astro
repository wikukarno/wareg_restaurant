---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  align?: "left" | "center";
  class?: string;
}
const { eyebrow, title, lead, align = "left", class: className = "" } = Astro.props;
const alignCls = align === "center" ? "text-center mx-auto" : "text-left";
---
<header class={`max-w-2xl ${alignCls} ${className}`}>
  {eyebrow && (
    <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--color-amber-600)]">
      {eyebrow}
    </p>
  )}
  <h2 class="mt-3 text-3xl md:text-4xl lg:text-5xl font-display leading-[1.05]" set:html={title} />
  {lead && <p class="mt-4 text-[var(--color-ink-soft)] text-lg leading-relaxed">{lead}</p>}
</header>
